server {
    listen 80;
    server_name intrentaka.com www.intrentaka.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name intrentaka.com www.intrentaka.com;

    ssl_certificate /etc/letsencrypt/live/intrentaka.com-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/intrentaka.com-0001/privkey.pem;

    # Emby Proxy settings
    location / {
        proxy_pass http://127.0.0.1:8096;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSockets support (Critical for Emby)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
